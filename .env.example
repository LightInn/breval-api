HOST=127.0.0.1
PORT=1337
APP_KEYS=local-development-key-1,local-development-key-2
API_TOKEN_SALT=local-development-api-token-salt
ADMIN_JWT_SECRET=local-development-admin-jwt-secret
JWT_SECRET=local-development-jwt-secret
TRANSFER_TOKEN_SALT=local-development-transfer-token-salt
ENCRYPTION_KEY=local-development-encryption-key

# Local database. Never point tests at a production database.
DB_CLIENT=sqlite
DB_FILENAME=.tmp/data.db

# Placeholder storage credentials: uploads require a real R2 service.
S3_BUCKET=local-test
S3_ACCESS_KEY_ID=local-test
S3_ACCESS_SECRET=local-test-secret
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=127.0.0.1:9000
S3_SSL=false
S3_PORT=9000

# PostgreSQL deployment: set DB_CLIENT=postgres and supply these variables.
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=replace-me
